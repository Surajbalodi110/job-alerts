TELEGRAM_BOT_TOKEN=put-your-bot-token-here
TELEGRAM_CHAT_ID=put-your-chat-id-here
POLL_SECONDS=600
# Optional free-tier keys (leave empty to skip):
# Adzuna (developer.adzuna.com) — best free source for India onsite jobs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# JSearch via RapidAPI — aggregates LinkedIn/Indeed/Glassdoor, ~500 req/mo free
# Get: rapidapi.com -> JSearch -> Subscribe (Basic free) -> copy X-RapidAPI-Key
RAPIDAPI_KEY=
# SerpAPI Google Jobs (serpapi.com, 100/mo free) — manual UI lookups; auto-watch only if SERPAPI_AUTO=1
# Get: serpapi.com -> Sign up -> Dashboard -> API Key
SERPAPI_KEY=
SERPAPI_AUTO=0
# Direct company boards (no keys, unlimited) — comma separated, 404s skipped
# Find slugs from the job URL: boards.greenhouse.io/{slug}, jobs.lever.co/{slug}
GREENHOUSE_BOARDS=datadog,cloudflare
LEVER_COMPANIES=lever,paytm
